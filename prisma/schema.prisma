generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                      String                                    @id
  nip                                     String                                    @unique
  username                                String
  password                                String?
  firstName                               String?
  lastName                                String?
  createdAt                               DateTime                                  @default(now())
  role                                    String?
  empoweringData                          EmpoweringData[]
  bedahWPData                             BedahWPData[]
  databaseWajibPajak                      DatabaseWajibPajak[]
  PembehananCabangPusatBedahEntitas       PembenahanCabangPusatBedahEntitas[]
  PembenahanWpNamaTtlSama                 PembenahanWpNamaTtlSama[]
  JawabanPembenahanCabangPusatBedaEntitas JawabanPembenahanCabangPusatBedaEntitas[]
  JawabanPembenahanWpNamaTtlSama          JawabanPembenahanWpNamaTtlSama[]
  JawabanPembenahanWpNikGanda             JawabanPembenahanWpNikGanda[]
  JawabanPembenahanWpIdentitasGanda       JawabanPembenahanWpIdentitasGanda[]
}

model EmpoweringData {
  id                    Int                  @id @default(autoincrement())
  npwp                  DatabaseWajibPajak?  @relation(fields: [npwpId], references: [id])
  npwpId                String?
  pelaksanaanKegiatan   DateTime?
  kpp                   String               @default("KPP Madya Dua Surabaya")
  tahunPajak            Int?
  createdAt             DateTime             @default(now())
  pph21                 Float?
  pph22                 Float?
  pph23                 Float?
  pph2529               Float?
  pph26                 Float?
  pphFinal              Float?
  pph15                 Float?
  ppn                   Float?
  pajakLainnya          Float?
  kunci                 Boolean?
  user                  User?                @relation(fields: [userId], references: [id])
  userId                String?
  sendingDataToKanwil   SendingDataToKanwil? @relation(fields: [sendingDataToKanwilId], references: [id])
  sendingDataToKanwilId Int?
}

model BedahWPData {
  id                    Int                  @id @default(autoincrement())
  npwp                  DatabaseWajibPajak?  @relation(fields: [npwpId], references: [id])
  npwpId                String?
  pelaksanaanKegiatan   DateTime?
  klasifikasi           String?
  tahunPajak            Int?
  createdAt             DateTime             @default(now())
  pph21                 Float?
  pph22                 Float?
  pph23                 Float?
  pph2529               Float?
  pph26                 Float?
  pphFinal              Float?
  pph15                 Float?
  kunci                 Boolean?             @default(false)
  ppn                   Float?
  pajakLainnya          Float?
  user                  User?                @relation(fields: [userId], references: [id])
  userId                String?
  sendingDataToKanwil   SendingDataToKanwil? @relation(fields: [sendingDataToKanwilId], references: [id])
  sendingDataToKanwilId Int?
}

model SendingDataToKanwil {
  id             Int              @id @default(autoincrement())
  nomorNd        String
  tanggalKirimNd DateTime
  statusKirim    String?
  createdAt      DateTime         @default(now())
  bedahWpData    BedahWPData[]
  empoweringData EmpoweringData[]
}

model DatabaseWajibPajak {
  id                   String                 @id
  nama                 String?
  alamat               String?
  kelurahan            String?
  kecamatan            String?
  kota                 String?
  propinsi             String?
  bentukHukum          String?
  jenis                String?
  klu                  String?
  tanggalDaftar        DateTime?
  tanggalPKP           DateTime?
  tanggalPencabutanPKP DateTime?
  nik                  String?
  status               String?
  nomorHp              String?
  empoweringData       EmpoweringData[]
  bedahWpData          BedahWPData[]
  nip                  User?                  @relation(fields: [nipId], references: [id])
  nipId                String?
  PembenahanWpNikGanda PembenahanWpNikGanda[]
}

model PembenahanCabangPusatBedahEntitas {
  id                                      Int                                       @id @default(autoincrement())
  npwpCabang                              String?
  namaCabang                              String?
  alamatCabang                            String?
  createdAt                               DateTime                                  @default(now())
  nomorHpCabang                           String?
  emailCabang                             String?
  kppCabang                               String?
  kanwilCabang                            String?
  nip                                     User?                                     @relation(fields: [nipId], references: [id])
  nipId                                   String?
  seksiCabang                             String?
  noKepCabang                             Int?
  validitasCabang                         String?
  statusCabang                            String?
  npwpPusat                               String?
  namaPusat                               String?
  kppPusat                                String?
  kanwilPusat                             String?
  arPusat                                 String?
  seksiPusat                              String?
  kepPusat                                Int?
  validitasPusat                          String?
  statusPusat                             String?
  namaBersihCabang                        String?
  namaBersihPusat                         String?
  nikBersihPusat                          String?
  nikBersihCabang                         String?
  tglBentukData                           String?
  currentStatus                           String?                                   @default("Progress")
  JawabanPembenahanCabangPusatBedaEntitas JawabanPembenahanCabangPusatBedaEntitas[]
}

model JawabanPembenahanCabangPusatBedaEntitas {
  id                      Int                                @id @default(autoincrement())
  data                    PembenahanCabangPusatBedahEntitas? @relation(fields: [dataId], references: [id])
  dataId                  Int?
  //Apakah NPWP Cabang Memiliki NPWP Pusat dengan Nomor NPWP Sebagai Berikut ?
  npwpCabangPusatQuestion String?
  //Apakah Nama Cabang Memiliki Nama Pusat dengan Nama Sebagai Berikut ?
  namaCabangPusatQuestion String?
  //Apakah Pemilik NIK Cabang dengan Nomor Ini memiliki Hubungan Dengan Pemilik Nik Pusat dengan Nomor NIK Sebagai Berikut ?
  nikCabangPusatQuestion  String?
  jawabanLangsung         String?
  perluDihapus            String?
  keterangan              String?
  createdAt               DateTime                           @default(now())
  user                    User?                              @relation(fields: [userId], references: [id])
  userId                  String?
}

